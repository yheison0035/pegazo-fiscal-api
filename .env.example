# === Base de datos (Postgres propio del servicio fiscal, separado del CRM) ===
DATABASE_URL="postgresql://usuario:clave@localhost:5432/pegazo_fiscal?schema=public"

# === Puerto del servicio ===
PORT=4100

# === Ambiente DIAN por defecto para nuevas empresas: "habilitacion" | "produccion" ===
DIAN_DEFAULT_ENV=habilitacion

# === Web services DIAN ===
DIAN_WS_HABILITACION="https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc"
DIAN_WS_PRODUCCION="https://vpfe.dian.gov.co/WcfDianCustomerServices.svc"

# === Clave maestra para cifrar los certificados .p12 de los clientes en reposo (AES-256) ===
# Generar con: openssl rand -hex 32
CERT_ENCRYPTION_KEY=""

# === Versiones de anexo técnico soportadas ===
UBL_INVOICE_VERSION="1.9"
